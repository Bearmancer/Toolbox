root = true

[*.cs]
# ══════════════════════════════════════════════════════════════════════
# var preferences
# ══════════════════════════════════════════════════════════════════════
csharp_style_var_when_type_is_obvious = true:warning
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_elsewhere = true:warning
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning

# ══════════════════════════════════════════════════════════════════════
# 1. new() when type is apparent (IDE0090)
# ══════════════════════════════════════════════════════════════════════
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_diagnostic.IDE0090.severity = warning

# ══════════════════════════════════════════════════════════════════════
# 2. Primary constructors (IDE0290)
# ══════════════════════════════════════════════════════════════════════
csharp_style_prefer_primary_constructors = true:warning
dotnet_diagnostic.IDE0290.severity = warning

# ══════════════════════════════════════════════════════════════════════
# 3. Collection expressions (IDE0300-IDE0306)
# ══════════════════════════════════════════════════════════════════════
dotnet_style_prefer_collection_expression = when_types_loosely_match:warning
dotnet_diagnostic.IDE0300.severity = warning
dotnet_diagnostic.IDE0301.severity = warning
dotnet_diagnostic.IDE0302.severity = warning
dotnet_diagnostic.IDE0303.severity = warning
dotnet_diagnostic.IDE0304.severity = warning
dotnet_diagnostic.IDE0305.severity = warning
dotnet_diagnostic.IDE0306.severity = warning

# ══════════════════════════════════════════════════════════════════════
# 5. Switch expressions over switch statements (IDE0066)
# ══════════════════════════════════════════════════════════════════════
csharp_style_prefer_switch_expression = true:warning
dotnet_diagnostic.IDE0066.severity = warning

# ══════════════════════════════════════════════════════════════════════
# 6. Static when instance unneeded (CA1822 + CA1052 + IDE0062)
# ══════════════════════════════════════════════════════════════════════
dotnet_diagnostic.CA1822.severity = warning
dotnet_diagnostic.CA1052.severity = warning
csharp_prefer_static_local_function = true:warning

# ══════════════════════════════════════════════════════════════════════
# 7. Disable unused variable/parameter flagging
# ══════════════════════════════════════════════════════════════════════

# IDE0059: Unnecessary assignment of a value to a variable
# Suppressed because: Discards and unused returns are common in async patterns
# and disposal patterns. The analyzer flags legitimate patterns like:
#   using var _ = Telemetry.ForService("Azure");
#   var _ = someDisposable;
dotnet_diagnostic.IDE0059.severity = none

# IDE0060: Remove unused parameter
# Suppressed because: Interface implementations and framework callbacks require
# parameters even when unused. Also, test scaffolding may have unused params.
dotnet_diagnostic.IDE0060.severity = none

# IDE0058: Expression value is never used
# Suppressed because: Fluent API calls and method chaining often return values
# that are intentionally ignored (e.g., builder patterns, LINQ side effects).
dotnet_diagnostic.IDE0058.severity = none

# IDE0051: Private member is unused
# Suppressed because: Framework-required members (like event handlers, DI factories)
# may appear unused to the analyzer but are needed at runtime.
dotnet_diagnostic.IDE0051.severity = none

# CS0219: Variable assigned but never used
# Suppressed because: Discard patterns and intentional unused variables are common
# in modern C# (e.g., using var _ = ...).
dotnet_diagnostic.CS0219.severity = none

# ══════════════════════════════════════════════════════════════════════
# Style rules that should not block build (suggestion only)
# ══════════════════════════════════════════════════════════════════════

# IDE0011: Add braces
# Suggestion because: Single-line if/else statements are acceptable for simple cases.
# Enforcing braces everywhere adds visual noise for trivial logic.
dotnet_diagnostic.IDE0011.severity = suggestion

# IDE0022: Use expression body for method
# Suggestion because: Expression bodies are preferred for single-line methods,
# but multi-line methods are clearer with block bodies.
dotnet_diagnostic.IDE0022.severity = suggestion

# IDE0008: Use explicit type instead of var
# Suppressed because: The project prefers var when type is apparent (see IDE0007/IDE0008 above).
# This rule conflicts with the var preference policy.
dotnet_diagnostic.IDE0008.severity = none

# ══════════════════════════════════════════════════════════════════════
# CA rules that are too noisy for existing codebase
# ══════════════════════════════════════════════════════════════════════

# CA1305: Specify IFormatProvider
# Suppressed because: Most string formatting in this CLI tool uses invariant culture
# by default. Requiring IFormatProvider everywhere adds boilerplate without benefit
# for a single-locale CLI tool.
dotnet_diagnostic.CA1305.severity = none

# CA1725: Parameter names should match base declaration
# Suppressed because: Renaming parameters to match interfaces would break existing
# callers using named arguments. The mismatch is intentional for clarity.
dotnet_diagnostic.CA1725.severity = none

# CA1852: Type can be sealed
# Suppressed because: Spectre.Console.Cli requires command types to be extensible.
# Sealing them would break the framework's inheritance model.
dotnet_diagnostic.CA1852.severity = none

# IDE0052: Private member can be removed (value never read)
# Suppressed because: Side-effect fields (like AzureEventSourceListener) need to
# exist to prevent garbage collection. The field stores a reference to keep the
# listener alive, even though it's never explicitly read.
dotnet_diagnostic.IDE0052.severity = none

# ══════════════════════════════════════════════════════════════════════
# 8+9. PascalCase for ALL variables, no _ for private fields
# ══════════════════════════════════════════════════════════════════════
# Private fields: PascalCase, no prefix
dotnet_naming_rule.private_fields_should_be_pascal_case.severity = warning
dotnet_naming_rule.private_fields_should_be_pascal_case.symbols = private_fields
dotnet_naming_rule.private_fields_should_be_pascal_case.style = pascal_case_style
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, internal

# Static fields: PascalCase, no prefix
dotnet_naming_rule.static_fields_should_be_pascal_case.severity = warning
dotnet_naming_rule.static_fields_should_be_pascal_case.symbols = static_fields
dotnet_naming_rule.static_fields_should_be_pascal_case.style = pascal_case_style
dotnet_naming_symbols.static_fields.applicable_kinds = field
dotnet_naming_symbols.static_fields.required_modifiers = static
dotnet_naming_symbols.static_fields.applicable_accessibilities = private, internal

# Constants: PascalCase
dotnet_naming_rule.constant_fields_should_be_pascal_case.severity = warning
dotnet_naming_rule.constant_fields_should_be_pascal_case.symbols = constant_fields
dotnet_naming_rule.constant_fields_should_be_pascal_case.style = pascal_case_style
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const

# Local variables and local functions: camelCase
dotnet_naming_rule.locals_should_be_camel_case.severity = warning
dotnet_naming_rule.locals_should_be_camel_case.symbols = locals
dotnet_naming_rule.locals_should_be_camel_case.style = camel_case_style
dotnet_naming_symbols.locals.applicable_kinds = local, local_function
dotnet_naming_symbols.locals.applicable_accessibilities = *

# Parameters: camelCase (required for override/interface compatibility)
dotnet_naming_rule.parameters_should_be_camel_case.severity = warning
dotnet_naming_rule.parameters_should_be_camel_case.symbols = parameters
dotnet_naming_rule.parameters_should_be_camel_case.style = camel_case_style
dotnet_naming_symbols.parameters.applicable_kinds = parameter
dotnet_naming_symbols.parameters.applicable_accessibilities = *

# Style definitions
dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.camel_case_style.capitalization = camel_case

# ══════════════════════════════════════════════════════════════════════
# Formatting
# ══════════════════════════════════════════════════════════════════════
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# ══════════════════════════════════════════════════════════════════════
# 10. Trailing commas - ReSharper inspection severity
# ══════════════════════════════════════════════════════════════════════
resharper_arrange_trailing_comma_in_multiline_lists_highlighting = error
resharper_arrange_trailing_comma_in_singleline_lists_highlighting = error

# ══════════════════════════════════════════════════════════════════════
# Tier 1 - Additional IDE Style Rules
# ══════════════════════════════════════════════════════════════════════

# Pattern matching preferences
dotnet_style_prefer_pattern_matching = true:warning
dotnet_style_prefer_not_pattern = true:warning
dotnet_style_prefer_tuple_swap = true:warning

# Null-checking preferences
dotnet_style_coalesce_expression = true:warning
dotnet_style_null_checking = true:warning

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:warning
csharp_style_expression_bodied_constructors = false:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:warning
csharp_style_expression_bodied_lambdas = true:warning
csharp_style_expression_bodied_local_functions = when_on_single_line:warning

# using preferences
csharp_using_directive_placement = outside_namespace:warning

# Namespace preferences
csharp_style_namespace_declarations = file_scoped:warning

# ══════════════════════════════════════════════════════════════════════
# Tier 2 - Modern C# Idiom Rules
# ══════════════════════════════════════════════════════════════════════

# Prefer range/index operators
dotnet_style_prefer_range_operator = true:warning
dotnet_style_prefer_index_operator = true:warning

# Prefer null-coalescing assignment
dotnet_style_prefer_null_over_ternary = true:warning

# Prefer string interpolation
dotnet_style_prefer_string_interpolation = true:warning

# Prefer object initializer
dotnet_style_object_initializer = true:warning
dotnet_style_collection_initializer = true:warning

# Prefer tuple type
dotnet_style_explicit_tuple_names = true:warning

# ══════════════════════════════════════════════════════════════════════
# Tier 3 - CA Performance Rules
# ══════════════════════════════════════════════════════════════════════

# Maintainability - Throw helpers
dotnet_diagnostic.CA1510.severity = warning
dotnet_diagnostic.CA1512.severity = warning
dotnet_diagnostic.CA1513.severity = warning

# Performance
dotnet_diagnostic.CA1864.severity = warning
dotnet_diagnostic.CA1870.severity = warning
